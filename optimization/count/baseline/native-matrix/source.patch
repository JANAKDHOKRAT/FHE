+extern "C" {
+TbgvContext tbgv_context_new_single(uint64_t p, uint32_t depth, uint32_t security, uint32_t digits) {
+    TBGV_TRY
+    CCParams<CryptoContextBGVRNS> params;
+    params.SetPlaintextModulus(p);
+    params.SetMultiplicativeDepth(depth);
+    params.SetMultipartyMode(FIXED_NOISE_MULTIPARTY);
+    params.SetScalingTechnique(FLEXIBLEAUTOEXT);
+    params.SetSecretKeyDist(UNIFORM_TERNARY);
+    if (digits) params.SetNumLargeDigits(digits);
+    switch (security) {
+        case 128: params.SetSecurityLevel(HEStd_128_classic); break;
+        case 192: params.SetSecurityLevel(HEStd_192_classic); break;
+        case 256: params.SetSecurityLevel(HEStd_256_classic); break;
+        default: set_error("security must be 128, 192 or 256"); return nullptr;
+    }
+    CC cc = GenCryptoContext(params);
+    cc->Enable(PKE); cc->Enable(KEYSWITCH); cc->Enable(LEVELEDSHE); cc->Enable(ADVANCEDSHE);
+    return new CC(cc);
+    TBGV_CATCH(nullptr)
+}
+int tbgv_context_is_single(TbgvContext ctx) {
+    TBGV_TRY
+    auto p = std::dynamic_pointer_cast<CryptoParametersBGVRNS>(cc_of(ctx)->GetCryptoParameters());
+    return p->GetMultipartyMode() == FIXED_NOISE_MULTIPARTY ? 1 : 0;
+    TBGV_CATCH(-1)
+}
+TbgvEvalKey tbgv_multkey_single(TbgvContext ctx, TbgvSecretKey sk) {
+    TBGV_TRY
+    cc_of(ctx)->EvalMultKeyGen(sk_of(sk));
+    const std::string tag = sk_of(sk)->GetKeyTag();
+    auto v = CryptoContextImpl<DCRTPoly>::GetEvalMultKeyVector(tag);
+    if (v.size() != 1) { set_error("expected one relinearization key"); return nullptr; }
+    EK k = v[0];
+    CryptoContextImpl<DCRTPoly>::ClearEvalMultKeys(tag);
+    return new EK(k);
+    TBGV_CATCH(nullptr)
+}
+}
